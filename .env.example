# Copy this file to `.env` and adjust for your environment.

# SQLAlchemy database URL. SQLite by default; Postgres example below.
# Postgres (docker compose): postgresql+psycopg2://vulnscope:vulnscope@db:5432/vulnscope
DATABASE_URL=sqlite:///./vulnscope.db

# JWT signing secret. MUST be set in production (the app refuses to start without it).
# Leave empty in development to auto-generate an ephemeral secret per process.
JWT_SECRET=

# JWT algorithm and token lifetime.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# "development" or "production".
ENVIRONMENT=development

# Allowed CORS origins as a JSON array. Empty means no cross-origin access (default, safe).
# Example: ["http://localhost:3000","https://app.example.com"]
CORS_ORIGINS=[]

# Celery broker + result backend (Redis).
REDIS_URL=redis://localhost:6379/0

# OWASP ZAP sidecar.
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=